---
extension: json
name: JSON 数据导出
description: 使用模板生成自定义 JSON 格式输出
---
{
  "journal_name": {{ journal.name | json }},
  "entry_count": {{ journal.entry_count }},
  "generated_at": "export",
  "entries": [
{% for entry in entries %}    {
      "date": {{ entry.date | date:'%Y-%m-%dT%H:%M:%S' | json }},
      "title": {{ entry.title | strip | json }},
      "starred": {% if entry.starred %}true{% else %}false{% endif %},
      "tags": [{% for tag in entry.tags %}{{ tag | json }}{% if not loop.last %}, {% endif %}{% endfor %}],
      "body_preview": {{ entry.body[:190] | truncate:190 | strip | json }}
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ],
  "tags_summary": {
{% for tag, count in journal.tags %}    {{ tag | json }}: {{ count }}{% if not loop.last %},{% endif %}
{% endfor %}
  }
}
